# SQL Server 2014 Database Credentials
DB_USER=sa
DB_PASSWORD=1234
DB_SERVER=127.0.0.1
DB_PORT=1551
DB_NAME=TICKET
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# Laravel Docker VPS Endpoint Configuration
LARAVEL_API_URL=http://127.0.0.1:8000/api/ticket-details/import-csv

# Query Settings (Joining PRODUCT table to fetch PRODUCT_NAME and Dyelots to fetch FabricName, CustomerName, ColorName, OrderNo, BATCH)
SQL_QUERY=SELECT TOP 1000 t.*, p.ProductName AS PRODUCT_NAME, d.FabricName AS FABRIC_NAME, d.CustomerName AS CUSTOMER_NAME, d.BATCH AS DYELOT_BATCH, d.ColorName AS COLOR_NAME, d.OrderNo AS ORDER_NO FROM [TICKET].[dbo].[TICKET_DETAIL] t LEFT JOIN [TICKET].[dbo].[PRODUCT] p ON t.PRODUCT_CODE = p.ProductCode LEFT JOIN [BatchDyeingCentral].[dbo].[Dyelots] d ON t.ID_NO = d.Dyelot ORDER BY t.ID_NO ASC

# Incremental Pull & Polling Settings
INCREMENTAL_ENABLE=true
INCREMENTAL_COLUMN=ID_NO
INCREMENTAL_TYPE=string
STATE_FILE=./state.json
POLL_INTERVAL_MS=5000

# Delta Load Settings (For updated ACTUAL_WT based on COMP_DATE & COMP_TIME)
DELTA_ENABLE=true
DELTA_COLUMN=COMP_DATE
DELTA_QUERY=SELECT TOP 1000 t.*, p.ProductName AS PRODUCT_NAME, d.FabricName AS FABRIC_NAME, d.CustomerName AS CUSTOMER_NAME, d.BATCH AS DYELOT_BATCH, d.ColorName AS COLOR_NAME, d.OrderNo AS ORDER_NO FROM [TICKET].[dbo].[TICKET_DETAIL] t LEFT JOIN [TICKET].[dbo].[PRODUCT] p ON t.PRODUCT_CODE = p.ProductCode LEFT JOIN [BatchDyeingCentral].[dbo].[Dyelots] d ON t.ID_NO = d.Dyelot WHERE (t.ACTUAL_WT IS NOT NULL AND t.ACTUAL_WT > 0) AND (t.COMP_DATE >= :last_delta_time OR :last_delta_time IS NULL) ORDER BY t.COMP_DATE ASC, t.COMP_TIME ASC

# Application Settings
TEMP_DIR=./tmp
LOG_LEVEL=info
